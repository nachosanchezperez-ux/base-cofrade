# Lectura pública y autenticación existente
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Escritura privada del formulario. Configúrala solo en el servidor.
# Se admite SUPABASE_SERVICE_ROLE_KEY como compatibilidad temporal.
SUPABASE_SECRET_KEY=

# Cloudflare Turnstile (plan gratuito)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Secreto aleatorio independiente recomendado para tickets y huellas HMAC.
CONTRIBUTION_FORM_SECRET=

# Mantener en false hasta aplicar migración, actualizar privacidad y probar Turnstile.
PUBLIC_CONTRIBUTIONS_ENABLED=false

